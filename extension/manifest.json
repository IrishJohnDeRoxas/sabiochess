{
  "manifest_version": 3,
  "name": "SabioChess - Chess.com Reviewer",
  "version": "1.1.0",
  "description": "One-click instant game review and Stockfish analysis sidebar for completed Chess.com games.",
  "permissions": [],
  "host_permissions": [
    "https://www.chess.com/*",
    "https://chess.com/*",
    "https://api.chess.com/*",
    "https://sabiochess.com/*",
    "https://sabiochess.irishjohnderoxas.workers.dev/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*", "https://chess.com/*"],
      "js": ["src/content/content.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["https://www.chess.com/*", "https://chess.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
