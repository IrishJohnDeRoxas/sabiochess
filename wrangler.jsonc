{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sabiochess",
	"main": "./server/index.ts",
	"compatibility_date": "2024-09-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist/sabiochess/browser",
		"not_found_handling": "single-page-application",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sabiochess-db",
			"database_id": "58b90970-6b31-450d-919e-757d06addb8c"
		}
	]
}
