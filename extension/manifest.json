{
  "manifest_version": 3,
  "name": "SabioChess - Free Chess Analysis & Game Review",
  "version": "1.2.9",
  "description": "Free chess analysis and game reviewer for Chess.com & Lichess. Instant Stockfish chess analyzer, eval bar, and blunder review.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.chess.com/*",
    "https://chess.com/*",
    "https://api.chess.com/*",
    "https://lichess.org/*",
    "https://*.lichess.org/*",
    "https://sabiochess.com/*",
    "https://sabiochess.irishjohnderoxas.workers.dev/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*",
        "https://lichess.org/*",
        "https://*.lichess.org/*"
      ],
      "js": ["src/content/content.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*",
        "https://lichess.org/*",
        "https://*.lichess.org/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
